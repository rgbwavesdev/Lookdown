<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Read-only access everywhere, so images next to a Markdown file and the settings file
	     in ~/Library/Application Support/Lookdown can be read. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
	</array>
	<!-- Lets JavaScriptCore compile the Markdown renderer instead of interpreting it
	     (about 4x faster on big files; required under the hardened runtime). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
